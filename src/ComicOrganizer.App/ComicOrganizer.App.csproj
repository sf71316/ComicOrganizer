<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Assist\comic_5318786.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release publish 設定 — 只在 `dotnet publish -c Release` 生效，不影響日常 build/run -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>          <!-- pre-JIT，啟動 -30~50% -->
    <PublishSingleFile>true</PublishSingleFile>          <!-- 打包成單一 exe -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>false</SelfContained>                 <!-- framework-dependent，~10 MB；user 需有 .NET 8 runtime。要做 self-contained (~80 MB 但免裝 runtime) 改 true -->
    <DebugType>embedded</DebugType>                      <!-- pdb 嵌入 exe，不留散檔 -->
  </PropertyGroup>

  <ItemGroup>
    <None Remove="UI\PoisonMainForm.resx~RF6dfc1fc.TMP" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assist\comic_5318786.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- EhTagTranslation/Database (CC BY-NC-SA 4.0) — bundle 翻譯 DB 給 #53 -->
    <EmbeddedResource Include="Resources\db.text.json.gz">
      <LogicalName>ComicOrganizer.App.Resources.db.text.json.gz</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.3.11" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="OpenCCNET" Version="1.1.0" />
    <PackageReference Include="SharpCompress" Version="0.47.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
