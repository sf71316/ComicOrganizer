<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Assist\comic_5318786.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release publish 設定 — 只在 `dotnet publish -c Release` 生效，不影響日常 build/run -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>          <!-- pre-JIT，啟動 -30~50% -->
    <PublishSingleFile>true</PublishSingleFile>          <!-- 打包成單一 exe -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>false</SelfContained>                 <!-- framework-dependent，~10 MB；user 需有 .NET 8 runtime。要做 self-contained (~80 MB 但免裝 runtime) 改 true -->
    <DebugType>embedded</DebugType>                      <!-- pdb 嵌入 exe，不留散檔 -->
  </PropertyGroup>

  <ItemGroup>
    <None Remove="UI\PoisonMainForm.resx~RF6dfc1fc.TMP" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assist\comic_5318786.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- EhTagTranslation/Database (CC BY-NC-SA 4.0) — bundle 翻譯 DB 給 #53 -->
    <EmbeddedResource Include="Resources\db.text.json.gz">
      <LogicalName>ComicOrganizer.App.Resources.db.text.json.gz</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.3.12" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenCCNET" Version="1.1.0" />
    <PackageReference Include="Paddle.Runtime.win_x64" Version="3.4.0" />
    <PackageReference Include="PaddleOCRSharp" Version="6.2.0" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <PackageReference Include="SharpCompress" Version="0.48.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UI\UserControl\GalleryControl.Dashboard.cs" />
    <Compile Update="UI\UserControl\GalleryControl.Drawer.cs" />
    <Compile Update="UI\UserControl\GalleryControl.ExternalSync.cs" />
    <Compile Update="UI\UserControl\GalleryControl.Gallery.cs" />
    <Compile Update="UI\UserControl\GalleryControl.Search.cs" />
    <Compile Update="UI\UserControl\GalleryControl.Tabs.cs" />
    <Compile Update="UI\UserControl\GalleryControl.Tree.cs" />
  </ItemGroup>

</Project>
