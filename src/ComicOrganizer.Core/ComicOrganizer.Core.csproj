<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ComicOrganizer.App" />
    <InternalsVisibleTo Include="ComicOrganizer.Tests" />
    <InternalsVisibleTo Include="ComicOrganizer.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <!-- EhTagTranslation/Database (CC BY-NC-SA 4.0) — 保留原 LogicalName 以相容 TagTranslationDb 與既有測試 -->
    <EmbeddedResource Include="Resources\db.text.json.gz">
      <LogicalName>ComicOrganizer.App.Resources.db.text.json.gz</LogicalName>
    </EmbeddedResource>
    <!-- 獅尾黑體 Medium (max32002/swei-sans, SIL OFL 1.1) — 漫畫譯文中黑體 -->
    <EmbeddedResource Include="Resources\fonts\SweiSansCJKtc-Medium.ttf">
      <LogicalName>ComicOrganizer.App.Resources.fonts.SweiSansCJKtc-Medium.ttf</LogicalName>
    </EmbeddedResource>
    <!-- 繁體常用詞表 (APCLab/jieba-tw, MIT) — 直排譯文避免詞中斷行 -->
    <EmbeddedResource Include="Resources\dict\zh_tw_words.txt.gz">
      <LogicalName>ComicOrganizer.App.Resources.dict.zh_tw_words.txt.gz</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="OpenCCNET" Version="1.1.0" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <PackageReference Include="SharpCompress" Version="0.48.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
