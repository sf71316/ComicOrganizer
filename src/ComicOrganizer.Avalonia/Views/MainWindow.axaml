<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 xmlns:vm="using:ComicOrganizer.Avalonia.ViewModels"
                 xmlns:controls="using:ComicOrganizer.Avalonia.Views.Controls"
                 x:Class="ComicOrganizer.Avalonia.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Title="ComicOrganizer"
                 Icon="avares://ComicOrganizer.Avalonia/Assets/app.ico"
                 Width="1360"
                 Height="860"
                 MinWidth="980"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 IsTitleBarVisible="True"
                 BackgroundStyle="GradientSoft">

  <suki:SukiWindow.Styles>
    <Style Selector="Button.titlebar-pill">
      <Setter Property="Background" Value="{DynamicResource WindowChromeTitleControlBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WindowChromeTitleControlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.titlebar-pill:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
    </Style>
  </suki:SukiWindow.Styles>

  <suki:SukiWindow.LogoContent>
    <Border Width="28" Height="28"
            CornerRadius="7"
            Padding="2"
            Background="{DynamicResource SukiPrimaryColor15}"
            BorderBrush="{DynamicResource SukiPrimaryColor50}"
            BorderThickness="1"
            VerticalAlignment="Center">
      <Image Source="avares://ComicOrganizer.Avalonia/Assets/app_icon.png"
             Stretch="Uniform"
             VerticalAlignment="Center"
             HorizontalAlignment="Center" />
    </Border>
  </suki:SukiWindow.LogoContent>

  <suki:SukiWindow.RightWindowTitleBarControls>
    <StackPanel Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                Margin="0,0,6,0">

      <!-- 全域搜尋框（支援 DSL / @artist: / @tag:） -->
      <TextBox Width="250"
               Height="30"
               FontSize="12.5"
               PlaceholderText="🔍 全域搜尋（支援 @artist: / @tag:）"
               Text="{Binding GlobalSearchText, Mode=TwoWay}"
               VerticalContentAlignment="Center">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding ExecuteGlobalSearchCommand}" />
        </TextBox.KeyBindings>
      </TextBox>

      <!-- 唯讀模式提示（僅以唯讀參數或 COMIC_ORGANIZER_READONLY=1 啟動時顯示） -->
      <Border CornerRadius="8"
              Padding="10,4"
              Background="{DynamicResource WindowChromeTitleControlBg}"
              BorderThickness="1"
              BorderBrush="{DynamicResource WindowChromeTitleControlBorder}"
              VerticalAlignment="Center"
              IsVisible="{Binding IsReadOnlyDatabase}"
              ToolTip.Tip="{Binding ReadOnlyBadgeTooltip}">
        <TextBlock Text="🔒 唯讀模式"
                   FontSize="12"
                   Opacity="0.88"
                   VerticalAlignment="Center" />
      </Border>

      <!-- 全域「📌 待挑書籃」抽屜切換 -->
      <Button Classes="Basic titlebar-pill"
              Padding="10,4"
              Height="30"
              VerticalAlignment="Center"
              Command="{Binding WorkBasket.ToggleOpenCommand}"
              ToolTip.Tip="展開／收合全域「📌 待挑書籃」（探索牆與畫廊跨頁面共用；關閉程式即清空，除非存成書單）">
        <TextBlock Text="{Binding WorkBasket.ToggleButtonLabel}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </Button>

      <!-- 主題強調色切換選單（9 色） -->
      <Button Classes="Basic titlebar-pill"
              Padding="10,4"
              Height="30"
              VerticalAlignment="Center"
              ToolTip.Tip="切換主題強調色">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Ellipse Width="10" Height="10" Fill="{Binding CurrentAccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CurrentAccentShortLabel}" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Text="▾" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <Flyout.FlyoutPresenterTheme>
              <ControlTheme TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                  <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                  </ControlTemplate>
                </Setter>
              </ControlTheme>
            </Flyout.FlyoutPresenterTheme>
            <Border Margin="8"
                    CornerRadius="12"
                    BoxShadow="0 10 26 0 #44000000">
              <suki:GlassCard IsOpaque="True"
                              CornerRadius="12"
                              Padding="10,8"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource SukiBorderBrush}">
                <StackPanel Spacing="4" Width="206">
                  <TextBlock Text="主題強調色"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Opacity="0.72"
                             Margin="6,2,0,2" />
                  <ItemsControl ItemsSource="{Binding AccentOptions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AccentThemeChoice">
                        <Button Classes="Basic"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,6"
                                CornerRadius="8"
                                Command="{Binding SelectCommand}">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Ellipse Grid.Column="0"
                                     Width="12" Height="12"
                                     Fill="{Binding SwatchBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="✓"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SukiPrimaryColor}"
                                       IsVisible="{Binding IsSelected}"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </suki:GlassCard>
            </Border>
          </Flyout>
        </Button.Flyout>
      </Button>

      <!-- 深色 / 淺色模式切換按鈕 -->
      <Button Classes="Basic titlebar-pill"
              Padding="10,4"
              Height="30"
              VerticalAlignment="Center"
              Command="{Binding ToggleThemeCommand}"
              ToolTip.Tip="切換深色 / 淺色模式">
        <TextBlock Text="{Binding ThemeToggleLabel}"
                   FontSize="12"
                   VerticalAlignment="Center" />
      </Button>

    </StackPanel>
  </suki:SukiWindow.RightWindowTitleBarControls>

  <suki:SukiWindow.Hosts>
    <suki:SukiToastHost Manager="{Binding ToastManager}" />
  </suki:SukiWindow.Hosts>

  <suki:SukiSideMenu x:Name="MainSideMenu"
                     IsMenuExpanded="{Binding IsSideMenuExpanded, Mode=TwoWay}"
                     OpenPaneLength="236"
                     SidebarToggleEnabled="True"
                     IsToggleButtonVisible="True"
                     IsSearchEnabled="False"
                     HeaderMinHeight="68"
                     UseCustomContent="True">

    <!-- 保留頁面 ＋ 右側全域共用「📌 待挑書籃」抽屜 -->
    <suki:SukiSideMenu.Content>
      <Grid ColumnDefinitions="*,Auto">
        <controls:KeepAlivePageHost Grid.Column="0" x:Name="PageHost" />

        <suki:GlassCard Grid.Column="1"
                        Width="352"
                        IsVisible="{Binding WorkBasket.IsOpen}"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,8,12,12">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">

            <!-- 標題列 -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="📌 待挑書籃" FontSize="15" FontWeight="Bold" />
                <TextBlock Text="{Binding WorkBasket.HeaderCountText}"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Opacity="0.72"
                           VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="Outlined"
                      Padding="8,4"
                      IsEnabled="{Binding WorkBasket.HasItems}"
                      Command="{Binding WorkBasket.ClearCommand}"
                      ToolTip.Tip="清空全部書籃項目">
                <TextBlock Text="清空" FontSize="11.5" />
              </Button>
              <Button Grid.Column="2"
                      Classes="Basic"
                      Padding="7,4"
                      Command="{Binding WorkBasket.CloseCommand}"
                      ToolTip.Tip="收合書籃抽屜">
                <TextBlock Text="✕" FontSize="12.5" />
              </Button>
            </Grid>

            <!-- 記憶體暫存提示 -->
            <Border Grid.Row="1"
                    Background="#1AF59E0B"
                    BorderBrush="#55F59E0B"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="9,6">
              <TextBlock Text="⚡ 僅暫存於記憶體：除非儲存為書單，否則關閉程式後即自動清空。"
                         FontSize="11.5"
                         TextWrapping="Wrap"
                         Foreground="#D97706" />
            </Border>

            <!-- 清單或空狀態 -->
            <Grid Grid.Row="2">
              <StackPanel IsVisible="{Binding WorkBasket.IsEmpty}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Spacing="8"
                          Margin="12">
                <TextBlock Text="📌" FontSize="32" HorizontalAlignment="Center" Opacity="0.45" />
                <TextBlock Text="書籃目前是空的"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="逛「探索牆」或「畫廊（目錄／作者／標籤／清單）」時，點作品上的「📌 挑書」就能跨頁暫存於此比較或存書單。"
                           FontSize="11.5"
                           Opacity="0.68"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
              </StackPanel>

              <ScrollViewer IsVisible="{Binding WorkBasket.HasItems}"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding WorkBasket.Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkBasketItemVm">
                      <Border BorderBrush="{DynamicResource SukiBorderBrush}"
                              BorderThickness="1"
                              Background="#10808080"
                              CornerRadius="10"
                              Padding="8"
                              Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Classes="Basic"
                                    Padding="0"
                                    Command="{Binding PreviewCommand}"
                                    Cursor="Hand"
                                    ToolTip.Tip="點擊快速預覽內頁">
                              <Border Width="42"
                                      Height="56"
                                      CornerRadius="6"
                                      ClipToBounds="True"
                                      Background="#18808080">
                                <Grid>
                                  <TextBlock Text="{Binding FallbackGlyph}"
                                             FontSize="18"
                                             FontWeight="Bold"
                                             Opacity="0.65"
                                             IsVisible="{Binding !HasCover}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                  <Image Source="{Binding Cover}"
                                         IsVisible="{Binding HasCover}"
                                         Stretch="UniformToFill" />
                                </Grid>
                              </Border>
                            </Button>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}"
                                         FontSize="12.5"
                                         FontWeight="SemiBold"
                                         MaxLines="2"
                                         TextWrapping="Wrap"
                                         TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding Title}" />
                              <TextBlock Text="{Binding SubtitleText}"
                                         FontSize="11"
                                         Opacity="0.68"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Classes="Basic"
                                    Padding="5,3"
                                    VerticalAlignment="Top"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip.Tip="從書籃單獨刪除此作品">
                              <TextBlock Text="✕" FontSize="11.5" Opacity="0.72" />
                            </Button>
                          </Grid>

                          <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="4">
                            <Button Grid.Column="0"
                                    Classes="Outlined"
                                    Padding="6,4"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding PreviewCommand}">
                              <TextBlock Text="👁 預覽" FontSize="11" />
                            </Button>
                            <Button Grid.Column="1"
                                    Classes="Flat"
                                    Padding="6,4"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding OpenInReaderCommand}">
                              <TextBlock Text="📖 開啟" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                            <Button Grid.Column="2"
                                    Classes="Outlined"
                                    Padding="6,4"
                                    IsEnabled="{Binding CanMoveUp}"
                                    Command="{Binding MoveUpCommand}"
                                    ToolTip.Tip="上移順序">
                              <TextBlock Text="↑" FontSize="11" />
                            </Button>
                            <Button Grid.Column="3"
                                    Classes="Outlined"
                                    Padding="6,4"
                                    IsEnabled="{Binding CanMoveDown}"
                                    Command="{Binding MoveDownCommand}"
                                    ToolTip.Tip="下移順序">
                              <TextBlock Text="↓" FontSize="11" />
                            </Button>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>

            <!-- 底部操作按鈕區（點擊儲存再跳出確認視窗，保留上方書籃最大顯示空間） -->
            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource SukiBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,10,0,0">
              <StackPanel Spacing="7">
                <Button Classes="Outlined"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="10,7"
                        IsEnabled="{Binding WorkBasket.HasItems}"
                        Command="{Binding WorkBasket.OpenAllInReaderCommand}"
                        ToolTip.Tip="將書籃內全部作品逐一以內建閱讀器開啟（不會移除書籃項目）">
                  <TextBlock Text="📖 全部使用閱讀器開啟" FontSize="12.5" FontWeight="SemiBold" />
                </Button>
                <Button Classes="Flat"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="10,7"
                        IsEnabled="{Binding WorkBasket.HasItems}"
                        Command="{Binding WorkBasket.RequestSaveToLibraryCommand}"
                        ToolTip.Tip="開啟確認視窗，選擇建立新書單或加入既有書單">
                  <TextBlock Text="💾 儲存至「⭐ 清單」" FontSize="12.5" FontWeight="SemiBold" />
                </Button>
              </StackPanel>
            </Border>

          </Grid>
        </suki:GlassCard>
      </Grid>
    </suki:SukiSideMenu.Content>

    <suki:SukiSideMenu.HeaderContent>
      <StackPanel Margin="14,12,14,8" Spacing="2">
        <TextBlock Text="ComicOrganizer"
                   FontSize="17"
                   FontWeight="Bold" />
        <TextBlock Text="本地漫畫庫與整理平台"
                   FontSize="11.5"
                   Opacity="0.65" />
      </StackPanel>
    </suki:SukiSideMenu.HeaderContent>

    <suki:SukiSideMenu.Items>

      <suki:SukiSideMenuItem Header="靈感探索牆" PageContent="{Binding ExplorePage}">
        <suki:SukiSideMenuItem.Icon>
          <TextBlock Text="✨" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </suki:SukiSideMenuItem.Icon>
      </suki:SukiSideMenuItem>

      <suki:SukiSideMenuItem Header="漫畫庫畫廊" PageContent="{Binding GalleryPage}">
        <suki:SukiSideMenuItem.Icon>
          <TextBlock Text="📚" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </suki:SukiSideMenuItem.Icon>
      </suki:SukiSideMenuItem>

      <suki:SukiSideMenuItem Header="閱讀軌跡" PageContent="{Binding ReadingTrackPage}">
        <suki:SukiSideMenuItem.Icon>
          <TextBlock Text="🕒" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </suki:SukiSideMenuItem.Icon>
      </suki:SukiSideMenuItem>

      <suki:SukiSideMenuItem Header="圖搜漫"
                             PageContent="{Binding VisualSearchPage}"
                             IsVisible="{Binding IsVisualSearchEnabled}">
        <suki:SukiSideMenuItem.Icon>
          <TextBlock Text="🔎" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </suki:SukiSideMenuItem.Icon>
      </suki:SukiSideMenuItem>

      <suki:SukiSideMenuItem Header="自動歸檔" PageContent="{Binding AutoArchivePage}">
        <suki:SukiSideMenuItem.Icon>
          <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </suki:SukiSideMenuItem.Icon>
      </suki:SukiSideMenuItem>

      <suki:SukiSideMenuItem Header="資料管理" PageContent="{Binding DataManagementPage}">
        <suki:SukiSideMenuItem.Icon>
          <TextBlock Text="🏷️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </suki:SukiSideMenuItem.Icon>
      </suki:SukiSideMenuItem>

      <suki:SukiSideMenuItem Header="系統設定" PageContent="{Binding SettingsPage}">
        <suki:SukiSideMenuItem.Icon>
          <TextBlock Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </suki:SukiSideMenuItem.Icon>
      </suki:SukiSideMenuItem>

    </suki:SukiSideMenu.Items>

  </suki:SukiSideMenu>

</suki:SukiWindow>
