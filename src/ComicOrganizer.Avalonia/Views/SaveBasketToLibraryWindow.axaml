<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 xmlns:core="using:ComicOrganizer.App.Core"
                 xmlns:vm="using:ComicOrganizer.Avalonia.ViewModels"
                 x:Class="ComicOrganizer.Avalonia.Views.SaveBasketToLibraryWindow"
                 x:DataType="vm:WorkBasketSaveViewModel"
                 Title="儲存書籃至「⭐ 清單」"
                 Icon="avares://ComicOrganizer.Avalonia/Assets/app.ico"
                 Width="470"
                 Height="470"
                 MinWidth="400"
                 MinHeight="380"
                 CanResize="True"
                 BackgroundStyle="GradientSoft">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16,10,16,16" RowSpacing="12">

    <suki:GlassCard Grid.Row="0" CornerRadius="12" Padding="14,10">
      <StackPanel Spacing="3">
        <TextBlock Text="⭐ 儲存待挑書籃為永久閱讀清單" FontSize="15" FontWeight="Bold" />
        <TextBlock Text="{Binding SummaryText}" FontSize="12" Opacity="0.74" />
      </StackPanel>
    </suki:GlassCard>

    <suki:GlassCard Grid.Row="1" CornerRadius="12" Padding="14,12">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">

        <RadioButton Grid.Row="0"
                     GroupName="BasketSaveMode"
                     IsChecked="{Binding IsCreateNewMode, Mode=TwoWay}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Content="＋ 建立新的閱讀清單" />

        <TextBox Grid.Row="1"
                 Margin="22,0,0,4"
                 IsEnabled="{Binding IsCreateNewMode}"
                 PlaceholderText="輸入新書單名稱（留空將使用預設時間名稱）…"
                 Text="{Binding NewLibraryName, Mode=TwoWay}" />

        <RadioButton Grid.Row="2"
                     GroupName="BasketSaveMode"
                     IsEnabled="{Binding CanMergeExisting}"
                     IsChecked="{Binding IsMergeExistingMode, Mode=TwoWay}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Content="📂 加入既有的閱讀清單" />

        <Border Grid.Row="3"
                Margin="22,0,0,0"
                BorderBrush="{DynamicResource SukiBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="#10808080">
          <Grid>
            <TextBlock Text="目前尚未建立任何既有書單"
                       IsVisible="{Binding !CanMergeExisting}"
                       FontSize="12"
                       Opacity="0.65"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <ListBox IsVisible="{Binding CanMergeExisting}"
                     IsEnabled="{Binding IsMergeExistingMode}"
                     ItemsSource="{Binding ExistingLibraries}"
                     SelectedItem="{Binding SelectedExistingLibrary, Mode=TwoWay}"
                     Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:VirtualLibrary">
                  <Grid ColumnDefinitions="*,Auto" Margin="4,3">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               FontSize="12.5"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="⭐"
                               FontSize="11.5"
                               Opacity="0.65"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   IsVisible="{Binding HasValidationError}"
                   Text="{Binding ValidationError}"
                   Foreground="#EF4444"
                   FontSize="12"
                   TextWrapping="Wrap" />
      </Grid>
    </suki:GlassCard>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <TextBlock Grid.Column="0"
                 Text="Esc 取消 / 確認後永久保存於書單"
                 FontSize="11.5"
                 Opacity="0.68"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1"
              Classes="Outlined"
              Padding="14,7"
              Command="{Binding CancelCommand}">
        <TextBlock Text="取消" FontSize="12.5" />
      </Button>
      <Button Grid.Column="2"
              Classes="Flat"
              Padding="16,7"
              Command="{Binding ConfirmSaveCommand}">
        <TextBlock Text="✓ 確認儲存" FontSize="12.5" FontWeight="SemiBold" />
      </Button>
    </Grid>

  </Grid>
</suki:SukiWindow>
