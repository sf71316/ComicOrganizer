<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 xmlns:vm="using:ComicOrganizer.Avalonia.ViewModels"
                 x:Class="ComicOrganizer.Avalonia.Views.WorkPreviewWindow"
                 x:DataType="vm:WorkPreviewViewModel"
                 Title="{Binding Title}"
                 Icon="avares://ComicOrganizer.Avalonia/Assets/app.ico"
                 Width="880"
                 Height="740"
                 MinWidth="660"
                 MinHeight="520"
                 BackgroundStyle="GradientSoft">

  <suki:SukiWindow.Styles>
    <Style Selector="Border.preview-thumb-card">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="#10808080" />
    </Style>
    <Style Selector="Border.preview-thumb-card.zoomed">
      <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
    </Style>
  </suki:SukiWindow.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="16,8,16,14" RowSpacing="10">

    <!-- 頂部：作品標題 ＋ 抽頁模式切換 -->
    <suki:GlassCard Grid.Row="0" CornerRadius="12" Padding="14,10">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Title}" />
            <TextBlock Text="{Binding Subtitle}"
                       FontSize="12"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Subtitle}" />
          </StackPanel>

          <Button Grid.Column="1"
                  Classes="Basic"
                  Padding="10,5"
                  Command="{Binding CloseWindowCommand}"
                  VerticalAlignment="Center"
                  ToolTip.Tip="關閉預覽視窗 (Esc)">
            <TextBlock Text="✕ 關閉" FontSize="12" />
          </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="抽頁模式：" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
          <ToggleButton Classes="Outlined"
                        Padding="10,5"
                        IsChecked="{Binding IsFrontSampleMode, Mode=OneWay}"
                        Command="{Binding SelectFrontSampleCommand}">
            <TextBlock Text="📖 開頭前 6 頁" FontSize="12" />
          </ToggleButton>
          <ToggleButton Classes="Outlined"
                        Padding="10,5"
                        IsChecked="{Binding IsUniformSampleMode, Mode=OneWay}"
                        Command="{Binding SelectUniformSampleCommand}">
            <TextBlock Text="🎯 全本均勻抽 6 頁" FontSize="12" />
          </ToggleButton>
          <ProgressBar IsIndeterminate="True"
                       IsVisible="{Binding IsLoading}"
                       Width="96"
                       Height="4"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
    </suki:GlassCard>

    <!-- 中央：預覽頁面清單與單頁放大區 -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">

        <Border IsVisible="{Binding HasError}"
                Background="#22EF4444"
                BorderBrush="#77EF4444"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="12.5" TextWrapping="Wrap" />
        </Border>

        <!-- 點擊縮圖後的放大檢視 -->
        <suki:GlassCard IsVisible="{Binding HasZoomPage}" CornerRadius="12" Padding="12">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Text="{Binding ZoomCaption}"
                         FontSize="13"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="Outlined"
                      Padding="8,4"
                      Command="{Binding CollapseZoomCommand}">
                <TextBlock Text="收合放大" FontSize="11.5" />
              </Button>
            </Grid>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsZoomLoading}" Height="3" />
            <Image Source="{Binding ZoomBitmap}"
                   MaxHeight="480"
                   Stretch="Uniform"
                   HorizontalAlignment="Center" />
          </StackPanel>
        </suki:GlassCard>

        <!-- 6 頁縮圖宮格 -->
        <ItemsControl ItemsSource="{Binding PreviewPages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WorkPreviewThumbVm">
              <Button Classes="Basic"
                      Padding="0"
                      Margin="0,0,10,10"
                      Command="{Binding SelectCommand}"
                      Cursor="Hand"
                      ToolTip.Tip="點擊放大檢視此頁">
                <Border Classes="preview-thumb-card"
                        Classes.zoomed="{Binding IsZoomed}"
                        Width="260"
                        ClipToBounds="True">
                  <StackPanel>
                    <Grid Height="310" Background="#14808080">
                      <TextBlock Text="⏳"
                                 FontSize="24"
                                 Opacity="0.5"
                                 IsVisible="{Binding !HasThumbnail}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                      <Image Source="{Binding Thumbnail}"
                             IsVisible="{Binding HasThumbnail}"
                             Stretch="Uniform" />
                    </Grid>
                    <Border Padding="8,5" Background="#18808080">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding PageLabel}" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="🔍 放大" FontSize="11" Opacity="0.7" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

    <!-- 底部動作列 -->
    <suki:GlassCard Grid.Row="2" CornerRadius="12" Padding="14,10">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBlock Grid.Column="0"
                   Text="💡 點擊任一頁縮圖即可放大檢視；按 Esc 關閉"
                   FontSize="12"
                   Opacity="0.72"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="Outlined"
                Padding="12,7"
                Command="{Binding ToggleBasketCommand}">
          <TextBlock Text="{Binding BasketActionText}" FontSize="12.5" FontWeight="SemiBold" />
        </Button>
        <Button Grid.Column="2"
                Classes="Flat"
                Padding="14,7"
                Command="{Binding OpenInReaderCommand}">
          <TextBlock Text="📖 正式以閱讀器開啟" FontSize="12.5" FontWeight="SemiBold" />
        </Button>
      </Grid>
    </suki:GlassCard>

  </Grid>
</suki:SukiWindow>
