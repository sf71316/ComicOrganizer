<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:ComicOrganizer.Avalonia.ViewModels"
             xmlns:controls="using:ComicOrganizer.Avalonia.Views.Controls"
             x:Class="ComicOrganizer.Avalonia.Views.AutoArchivePageView"
             x:DataType="vm:AutoArchivePageViewModel">

  <UserControl.Resources>
    <!-- 分群檢視與平面列表共用的單筆候選項目列（支援來源與目標目錄名稱自動斷行） -->
    <DataTemplate x:Key="AutoArchiveCandidateRowTemplate" x:DataType="vm:AutoArchiveCandidateVm">
      <controls:StableDataContextHost>
        <Border Margin="0,3"
                Padding="10,8"
                CornerRadius="9"
                BorderThickness="1"
                BorderBrush="{DynamicResource SukiBorderBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto,260,Auto,Auto" ColumnSpacing="10">
          <CheckBox Grid.Column="0"
                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                    VerticalAlignment="Center" />

          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
              <Border Grid.Column="0"
                      CornerRadius="5"
                      Padding="6,2"
                      Background="#16808080"
                      VerticalAlignment="Top"
                      Margin="0,1,0,0">
                <TextBlock Text="{Binding TypeBadgeText}" FontSize="10.5" FontWeight="SemiBold" />
              </Border>
              <TextBlock Grid.Column="1"
                         Text="{Binding SourceName}"
                         FontSize="13"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         ToolTip.Tip="{Binding SourceFullPath}" />
            </Grid>
            <TextBlock Text="{Binding ExecutionMessage}"
                       FontSize="11"
                       Opacity="0.68"
                       IsVisible="{Binding ExecutionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding MatchSourceLabel}" FontSize="11.5" VerticalAlignment="Center" />
            <Border CornerRadius="5" Padding="6,2" Background="{DynamicResource SukiPrimaryColor15}">
              <TextBlock Text="{Binding ConfidenceText}"
                         FontSize="11.5"
                         FontWeight="Bold"
                         Foreground="{DynamicResource SukiPrimaryColor}" />
            </Border>
          </StackPanel>

          <ComboBox Grid.Column="3"
                    ItemsSource="{Binding TargetFolderOptions}"
                    SelectedItem="{Binding SelectedTargetFolder, Mode=TwoWay}"
                    FontSize="12"
                    MinHeight="34"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding DestinationPath}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Border Grid.Column="4"
                  CornerRadius="6"
                  Padding="8,3"
                  Background="#14808080"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding ExecutionStatus}" FontSize="11.5" />
          </Border>

          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Classes="Basic" Padding="6,4" Command="{Binding InspectInReaderCommand}" ToolTip.Tip="以內建閱讀器預覽內容">
              <TextBlock Text="📖" FontSize="12" />
            </Button>
            <Button Classes="Basic" Padding="6,4" Command="{Binding RevealInExplorerCommand}" ToolTip.Tip="在檔案總管中顯示">
              <TextBlock Text="📂" FontSize="12" />
            </Button>
            <Button Classes="Basic" Padding="6,4" Command="{Binding RemoveFromListCommand}" ToolTip.Tip="從預覽清單移除">
              <TextBlock Text="×" FontSize="13" />
            </Button>
          </StackPanel>
        </Grid>
        </Border>
      </controls:StableDataContextHost>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.filter-pill">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button:pointerover Border.filter-pill">
      <Setter Property="Background" Value="#14808080" />
    </Style>
    <Style Selector="Border.filter-pill.active">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor15}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
    </Style>
    <Style Selector="Border.filter-pill.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SukiPrimaryColor}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.group-header-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_HeaderBg"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.group-header-btn:pointerover">
      <Setter Property="Background" Value="#16808080" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.group-header-btn:pressed">
      <Setter Property="Background" Value="#24808080" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,Auto" Margin="18,14,18,16">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
    <!-- 1. 標題與設定摘要卡片 -->
    <suki:GlassCard Grid.Row="0" CornerRadius="14" Padding="16,12" Margin="0,0,0,10">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="📦 自動歸檔與智慧配對" FontSize="20" FontWeight="Bold" />
              <Border CornerRadius="6"
                      Padding="8,2"
                      Background="{DynamicResource SukiPrimaryColor15}"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding RulesSummaryText}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SukiPrimaryColor}" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12.5"
                       Opacity="0.82"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="Flat"
                    Padding="14,7"
                    Command="{Binding ScanCommand}"
                    IsEnabled="{Binding !IsBusy}">
              <TextBlock Text="🔍 掃描與智慧配對" FontSize="12.5" FontWeight="SemiBold" />
            </Button>

            <Button Classes="Outlined"
                    Padding="12,7"
                    Command="{Binding ToggleQueueDrawerCommand}"
                    ToolTip.Tip="展開／收合右側「📥 待歸檔清單」抽屜，統一檢視或一鍵全部歸檔">
              <TextBlock Text="{Binding QueueToggleButtonLabel}"
                         FontSize="12.5"
                         FontWeight="SemiBold" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- 路徑摘要列 -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Grid.Column="0"
                  CornerRadius="8"
                  Padding="10,6"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SukiBorderBrush}">
            <StackPanel Spacing="2">
              <TextBlock Text="來源未整理目錄" FontSize="11" Opacity="0.65" />
              <TextBlock Text="{Binding UnorganizedDirectoryText}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UnorganizedDirectoryText}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  CornerRadius="8"
                  Padding="10,6"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SukiBorderBrush}">
            <StackPanel Spacing="2">
              <TextBlock Text="目標漫畫庫根目錄" FontSize="11" Opacity="0.65" />
              <TextBlock Text="{Binding RootDirectoryText}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RootDirectoryText}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- 共用開發庫唯讀警示橫幅 -->
        <Border CornerRadius="8"
                Padding="10,6"
                Background="#18F59E0B"
                BorderBrush="#66F59E0B"
                BorderThickness="1"
                IsVisible="{Binding IsReadOnlyDatabase}">
          <TextBlock Text="{Binding ReadOnlyBannerText}"
                     FontSize="12"
                     Foreground="#F59E0B"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </suki:GlassCard>

    <!-- 2. 檢視模式、篩選與批次勾選列 -->
    <suki:GlassCard Grid.Row="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
      <StackPanel Spacing="7">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Classes="Basic" Padding="0" Command="{Binding SelectViewModeCommand}" CommandParameter="Grouped">
              <Border Classes="filter-pill" Classes.active="{Binding IsGroupedView}">
                <TextBlock Text="📂 依目錄分群" FontSize="12" />
              </Border>
            </Button>
            <Button Classes="Basic" Padding="0" Command="{Binding SelectViewModeCommand}" CommandParameter="Flat">
              <Border Classes="filter-pill" Classes.active="{Binding IsFlatView}">
                <TextBlock Text="📋 項目列表" FontSize="12" />
              </Border>
            </Button>
          </StackPanel>

          <Border Grid.Column="1" Width="1" Height="18" Background="{DynamicResource SukiBorderBrush}" Margin="10,0" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Classes="Basic" Padding="0" Command="{Binding SelectFilterTabCommand}" CommandParameter="All">
              <Border Classes="filter-pill" Classes.active="{Binding IsAllFilterTab}">
                <TextBlock Text="{Binding TotalScannedCount, StringFormat='全部 ({0})'}" FontSize="12" />
              </Border>
            </Button>
            <Button Classes="Basic" Padding="0" Command="{Binding SelectFilterTabCommand}" CommandParameter="Checked">
              <Border Classes="filter-pill" Classes.active="{Binding IsCheckedFilterTab}">
                <TextBlock Text="{Binding CheckedCount, StringFormat='已勾選 ({0})'}" FontSize="12" />
              </Border>
            </Button>
            <Button Classes="Basic" Padding="0" Command="{Binding SelectFilterTabCommand}" CommandParameter="Unmatched">
              <Border Classes="filter-pill" Classes.active="{Binding IsUnmatchedFilterTab}">
                <TextBlock Text="{Binding UnmatchedCount, StringFormat='未匹配 ({0})'}" FontSize="12" />
              </Border>
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="3"
                      Orientation="Horizontal"
                      Spacing="6"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsGroupedView}">
            <Button Classes="Basic" Padding="8,4" Command="{Binding ExpandAllGroupsCommand}">
              <TextBlock Text="全部展開" FontSize="11.5" />
            </Button>
            <Button Classes="Basic" Padding="8,4" Command="{Binding CollapseAllGroupsCommand}">
              <TextBlock Text="全部收合" FontSize="11.5" />
            </Button>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox Grid.Column="0"
                   MaxWidth="360"
                   HorizontalAlignment="Left"
                   PlaceholderText="過濾來源名稱或目標目錄…"
                   Text="{Binding FilterKeyword, Mode=TwoWay}"
                   FontSize="12"
                   VerticalAlignment="Center" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="Outlined" Padding="9,4" Command="{Binding CheckHighConfidenceCommand}">
              <TextBlock Text="勾選高信心 (≥85%)" FontSize="11.5" />
            </Button>
            <Button Classes="Outlined" Padding="9,4" Command="{Binding CheckAllMatchedCommand}">
              <TextBlock Text="全選已匹配" FontSize="11.5" />
            </Button>
            <Button Classes="Basic" Padding="9,4" Command="{Binding UncheckAllCommand}">
              <TextBlock Text="全不選" FontSize="11.5" />
            </Button>
            <Border Width="1" Height="16" Background="{DynamicResource SukiBorderBrush}" Margin="2,0" />
            <Button Classes="Flat"
                    Padding="10,4"
                    Command="{Binding AddAllCheckedToQueueCommand}"
                    ToolTip.Tip="將目前已勾選且具目標目錄的作品全部放入右側「📥 待歸檔清單」">
              <TextBlock Text="{Binding CheckedCount, StringFormat='📥 勾選入清單 ({0})'}" FontSize="11.5" FontWeight="SemiBold" />
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </suki:GlassCard>

    <!-- 3. 預覽與微調清單主區 -->
    <suki:GlassCard Grid.Row="2" CornerRadius="14" Padding="10">
      <Grid>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    IsVisible="{Binding !HasCandidates}">
          <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center" Opacity="0.6" />
          <TextBlock Text="目前清單為空" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="請點擊上方「🔍 掃描與智慧配對」，系統將自動比對知識庫與目標作者目錄並產生預覽清單。"
                     FontSize="12.5"
                     Opacity="0.7" />
        </StackPanel>

        <Grid IsVisible="{Binding HasCandidates}">
          <!-- 依目標目錄分群檢視 -->
          <ScrollViewer IsVisible="{Binding IsGroupedView}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding TargetGroups}"
                          Margin="0,0,8,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AutoArchiveTargetGroupVm">
                  <Border Margin="0,4"
                          CornerRadius="12"
                          ClipToBounds="True"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource SukiBorderBrush}"
                          Background="#0B808080">
                    <StackPanel>
                      <Border Padding="10,7"
                              Background="#12808080">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                          <CheckBox Grid.Column="0"
                                    Margin="2,0,0,0"
                                    IsChecked="{Binding IsGroupChecked, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="一鍵全選／取消此目標目錄底下的所有項目" />

                          <!-- 點擊整條標題列任何位置（目錄名稱、統計徽章或箭頭）即可展開／收合 -->
                          <Button Grid.Column="1"
                                  Classes="group-header-btn"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Padding="8,5"
                                  CornerRadius="8"
                                  Cursor="Hand"
                                  Command="{Binding ToggleExpandCommand}"
                                  ToolTip.Tip="點擊標題列展開／收合此目標目錄群組">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding GroupHeaderTitle}"
                                         FontSize="14"
                                         FontWeight="Bold"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center" />

                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border CornerRadius="6"
                                        Padding="8,2"
                                        Background="#22F59E0B"
                                        BorderBrush="#66F59E0B"
                                        BorderThickness="1"
                                        IsVisible="{Binding HasLowConfidenceItem}">
                                  <TextBlock Text="{Binding GroupConfidenceBadgeText}"
                                             FontSize="11.5"
                                             FontWeight="SemiBold"
                                             Foreground="#F59E0B" />
                                </Border>
                                <Border CornerRadius="6"
                                        Padding="8,2"
                                        Background="{DynamicResource SukiPrimaryColor15}"
                                        IsVisible="{Binding HasNormalConfidenceBadge}">
                                  <TextBlock Text="{Binding GroupConfidenceBadgeText}"
                                             FontSize="11.5"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource SukiPrimaryColor}" />
                                </Border>
                              </StackPanel>

                              <Border Grid.Column="2"
                                      CornerRadius="6"
                                      Padding="8,2"
                                      Background="#16808080"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding SummaryBadgeText}" FontSize="11.5" FontWeight="SemiBold" />
                              </Border>

                              <TextBlock Grid.Column="3"
                                         Text="{Binding ExpandGlyph}"
                                         FontSize="13"
                                         FontWeight="Bold"
                                         Margin="2,0,4,0"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </Button>

                          <Button Grid.Column="2"
                                  Classes="Outlined"
                                  Padding="10,5"
                                  Command="{Binding AddCheckedToQueueCommand}"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="將此目錄群組內有打勾的作品放入右側「📥 待歸檔清單」">
                            <TextBlock Text="{Binding AddToQueueButtonText}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                          </Button>
                        </Grid>
                      </Border>

                      <ItemsControl IsVisible="{Binding IsExpanded}"
                                    ItemsSource="{Binding Items}"
                                    ItemTemplate="{StaticResource AutoArchiveCandidateRowTemplate}"
                                    Margin="8,4,8,8" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- 平面項目列表檢視（ItemsRepeater 虛擬化） -->
          <ScrollViewer IsVisible="{Binding IsFlatView}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{Binding VisibleCandidates}"
                           ItemTemplate="{StaticResource AutoArchiveCandidateRowTemplate}"
                           Margin="0,0,8,0" />
          </ScrollViewer>
        </Grid>
      </Grid>
    </suki:GlassCard>
    </Grid>

    <!-- 右側：比照「待挑書籃」模式的「📥 待歸檔清單」抽屜 -->
    <suki:GlassCard Grid.Column="1"
                    Width="364"
                    IsVisible="{Binding IsQueueDrawerOpen}"
                    CornerRadius="14"
                    Padding="14"
                    Margin="12,0,0,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">

        <!-- 抽屜標題列 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="📥 待歸檔清單" FontSize="15" FontWeight="Bold" />
            <TextBlock Text="{Binding QueueHeaderCountText}"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       Opacity="0.72"
                       VerticalAlignment="Center" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="Outlined"
                  Padding="8,4"
                  IsEnabled="{Binding HasQueuedItems}"
                  Command="{Binding ClearQueueCommand}"
                  ToolTip.Tip="清空全部待歸檔項目（不會刪除硬碟檔案）">
            <TextBlock Text="清空" FontSize="11.5" />
          </Button>
          <Button Grid.Column="2"
                  Classes="Basic"
                  Padding="7,4"
                  Command="{Binding CloseQueueDrawerCommand}"
                  ToolTip.Tip="收合待歸檔清單抽屜">
            <TextBlock Text="✕" FontSize="12.5" />
          </Button>
        </Grid>

        <!-- 操作提示 -->
        <Border Grid.Row="1"
                Background="{DynamicResource SukiPrimaryColor15}"
                BorderBrush="{DynamicResource SukiPrimaryColor50}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="9,6">
          <TextBlock Text="在左側各群組勾選確認後按「📥 放入清單」，可在此最後複檢或移除不需要的作品，再一鍵全部歸檔。"
                     FontSize="11.5"
                     TextWrapping="Wrap"
                     Opacity="0.9" />
        </Border>

        <!-- 清單或空狀態 -->
        <Grid Grid.Row="2">
          <StackPanel IsVisible="{Binding IsQueueEmpty}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Spacing="8"
                      Margin="12">
            <TextBlock Text="📥" FontSize="32" HorizontalAlignment="Center" Opacity="0.45" />
            <TextBlock Text="待歸檔清單目前是空的"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="在左側目標目錄分群標題旁點擊「📥 放入清單」，即可將群組內勾選作品統一收攏至此確認搬移。"
                       FontSize="11.5"
                       Opacity="0.68"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
          </StackPanel>

          <ScrollViewer IsVisible="{Binding HasQueuedItems}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding QueuedItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AutoArchiveQueuedItemVm">
                  <Border BorderBrush="{DynamicResource SukiBorderBrush}"
                          BorderThickness="1"
                          Background="#10808080"
                          CornerRadius="10"
                          Padding="9"
                          Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <StackPanel Grid.Column="0" Spacing="3">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border CornerRadius="5" Padding="5,1" Background="#16808080">
                              <TextBlock Text="{Binding TypeBadgeText}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <Border CornerRadius="5" Padding="5,1" Background="#14808080">
                              <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding SourceName}"
                                     FontSize="12.5"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"
                                     ToolTip.Tip="{Binding SourceFullPath}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="Basic"
                                Padding="5,3"
                                VerticalAlignment="Top"
                                IsEnabled="{Binding !IsProcessing}"
                                Command="{Binding RemoveCommand}"
                                ToolTip.Tip="從待歸檔清單移除此作品">
                          <TextBlock Text="✕" FontSize="11.5" Opacity="0.72" />
                        </Button>
                      </Grid>

                      <Border CornerRadius="6"
                              Padding="7,4"
                              Background="{DynamicResource SukiPrimaryColor10}">
                        <TextBlock Text="{Binding TargetFolderName, StringFormat='→ 📁 {0}'}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SukiPrimaryColor}"
                                   TextWrapping="Wrap"
                                   ToolTip.Tip="{Binding DestinationPath}" />
                      </Border>

                      <TextBlock Text="{Binding StatusMessage}"
                                 FontSize="11"
                                 Opacity="0.72"
                                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 TextWrapping="Wrap" />

                      <StackPanel Spacing="3" IsVisible="{Binding IsProcessing}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                          <TextBlock Grid.Column="0"
                                     Text="{Binding StatusText}"
                                     FontSize="10.5"
                                     Opacity="0.82" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding ProgressText}"
                                     FontSize="10.5"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource SukiPrimaryColor}" />
                        </Grid>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ProgressValue}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                     Height="5"
                                     CornerRadius="2" />
                      </StackPanel>

                      <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button Grid.Column="0"
                                Classes="Outlined"
                                Padding="6,4"
                                HorizontalContentAlignment="Center"
                                Command="{Binding InspectInReaderCommand}">
                          <TextBlock Text="📖 預覽" FontSize="11" />
                        </Button>
                        <Button Grid.Column="1"
                                Classes="Outlined"
                                Padding="6,4"
                                HorizontalContentAlignment="Center"
                                Command="{Binding RevealInExplorerCommand}">
                          <TextBlock Text="📂 位置" FontSize="11" />
                        </Button>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- 底部統一執行區（一鍵全部歸檔） -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource SukiBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,10,0,0">
          <StackPanel Spacing="7">
            <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0"
                           Text="{Binding BatchProgressText}"
                           FontSize="11.5"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="1"
                           Text="{Binding BatchProgressPercent, StringFormat='{}{0:F0}%'}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SukiPrimaryColor}" />
              </Grid>
              <ProgressBar Minimum="0"
                           Maximum="100"
                           Value="{Binding BatchProgressPercent}"
                           Height="5"
                           CornerRadius="2" />
            </StackPanel>

            <Button Classes="Flat"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="10,8"
                    IsEnabled="{Binding CanExecuteQueue}"
                    Command="{Binding ExecuteQueueCommand}"
                    ToolTip.Tip="將清單內全部項目一次搬移至各自目標目錄並寫入知識庫">
              <TextBlock Text="{Binding QueueCount, StringFormat='📦 一鍵全部歸檔 ({0})'}" FontSize="12.5" FontWeight="SemiBold" />
            </Button>
          </StackPanel>
        </Border>

      </Grid>
    </suki:GlassCard>
  </Grid>
</UserControl>
