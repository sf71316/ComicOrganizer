<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:ComicOrganizer.Avalonia.ViewModels"
             xmlns:views="using:ComicOrganizer.Avalonia.Views"
             x:Class="ComicOrganizer.Avalonia.Views.Controls.DslSearchBox"
             x:DataType="vm:DslSearchBoxViewModel">

  <UserControl.Resources>
    <views:HexToBrushConverter x:Key="HexToBrushConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 搜尋外框 -->
    <Style Selector="Border.dsl-search-frame">
      <Setter Property="Background" Value="#14808080" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="Border.dsl-search-frame:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
      <Setter Property="Background" Value="#1C808080" />
    </Style>

    <!-- 區塊化條件膠囊 Chip -->
    <Style Selector="Border.dsl-token-chip">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor15}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="Margin" Value="0,2,6,2" />
    </Style>
    <Style Selector="Border.dsl-token-chip.negated">
      <Setter Property="Background" Value="#24EF4444" />
      <Setter Property="BorderBrush" Value="#EF4444" />
    </Style>

    <!-- 快捷欄位提示小按鈕 -->
    <Style Selector="Border.dsl-quick-chip">
      <Setter Property="Background" Value="#12808080" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="Button:pointerover Border.dsl-quick-chip">
      <Setter Property="Background" Value="#24808080" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
    </Style>

    <!-- 自動完成候選列 -->
    <Style Selector="Border.dsl-suggestion-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button:pointerover Border.dsl-suggestion-row">
      <Setter Property="Background" Value="#1E808080" />
    </Style>
    <Style Selector="Border.dsl-suggestion-row.selected">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor15}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="6">

    <!-- 主搜尋框：左側放大鏡 ＋ 已區塊化標籤膠囊列 ＋ 內嵌文字輸入框 ＋ @ 喚出鈕 ＋ 清除鈕 -->
    <Border x:Name="SearchBoxFrame"
            Classes="dsl-search-frame"
            PointerPressed="OnFramePointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">

        <TextBlock Grid.Column="0"
                   Text="🔍"
                   FontSize="13.5"
                   Opacity="0.72"
                   VerticalAlignment="Center"
                   Margin="2,0,0,0" />

        <WrapPanel Grid.Column="1"
                   Orientation="Horizontal"
                   VerticalAlignment="Center">

          <!-- 已收斂的結構化條件區塊（Token Chips） -->
          <ItemsControl ItemsSource="{Binding TokenBlocks}"
                        VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DslTokenBlockVm">
                <Border Classes="dsl-token-chip"
                        Classes.negated="{Binding IsNegated}"
                        ToolTip.Tip="{Binding TooltipText}">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Button Classes="Basic"
                            Padding="0"
                            Command="{Binding EditCommand}"
                            Cursor="Hand">
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Icon}" FontSize="11.5" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FieldBadgeText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.82"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=":"
                                   FontSize="11"
                                   Opacity="0.6"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ValueText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   MaxWidth="180"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>

                    <Button Classes="Basic"
                            Padding="3,0"
                            Command="{Binding RemoveCommand}"
                            Cursor="Hand"
                            ToolTip.Tip="移除此條件區塊">
                      <TextBlock Text="✕"
                                 FontSize="10.5"
                                 Opacity="0.75"
                                 VerticalAlignment="Center" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 尾端動態文字輸入區 -->
          <TextBox x:Name="InnerTextBox"
                   MinWidth="190"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="4,3"
                   FontSize="13"
                   VerticalAlignment="Center"
                   VerticalContentAlignment="Center"
                   Watermark="{Binding Watermark}"
                   Text="{Binding InputText, Mode=TwoWay}" />
        </WrapPanel>

        <!-- @ 標籤模式快捷喚出按鈕 -->
        <Button Grid.Column="2"
                Classes="Basic"
                Padding="7,3"
                Command="{Binding TriggerAtMenuCommand}"
                VerticalAlignment="Center"
                ToolTip.Tip="插入 @ 喚出標籤／作者區塊自動完成選單">
          <Border CornerRadius="6"
                  Background="#1A808080"
                  BorderBrush="{DynamicResource SukiBorderBrush}"
                  BorderThickness="1"
                  Padding="6,2">
            <TextBlock Text="@ 標籤"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Opacity="0.86" />
          </Border>
        </Button>

        <!-- 一鍵清空（區塊＋文字） -->
        <Button Grid.Column="3"
                Classes="Basic"
                Padding="6,2"
                IsVisible="{Binding HasAnyContent}"
                Command="{Binding ClearAllCommand}"
                VerticalAlignment="Center"
                ToolTip.Tip="清空所有標籤區塊與搜尋文字">
          <TextBlock Text="✕" FontSize="12" Opacity="0.72" />
        </Button>

      </Grid>
    </Border>

    <!-- 下方欄位區塊快捷提示列（點擊直接帶出 @artist: / @tag: 等資料庫候選） -->
    <WrapPanel x:Name="QuickFieldBar"
               Orientation="Horizontal"
               VerticalAlignment="Center">
      <TextBlock Text="區塊語法："
                 FontSize="11"
                 Opacity="0.58"
                 VerticalAlignment="Center"
                 Margin="2,0,6,3" />
      <ItemsControl ItemsSource="{Binding QuickFieldChips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DslQuickFieldChipVm">
            <Button Classes="Basic"
                    Padding="0"
                    Margin="0,0,5,3"
                    Command="{Binding ActivateCommand}"
                    Cursor="Hand"
                    ToolTip.Tip="{Binding TooltipText}">
              <Border Classes="dsl-quick-chip">
                <TextBlock Text="{Binding DisplayLabel}"
                           FontSize="11"
                           Opacity="0.86" />
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </WrapPanel>

    <!-- 下拉自動完成懸浮玻璃面板 -->
    <Popup x:Name="SuggestionPopup"
           PlacementTarget="{Binding #SearchBoxFrame}"
           Placement="BottomEdgeAlignedLeft"
           VerticalOffset="4"
           IsLightDismissEnabled="True"
           IsOpen="{Binding IsSuggestionPopupOpen, Mode=TwoWay}">
      <Border Width="540"
              MaxWidth="640"
              CornerRadius="12"
              BoxShadow="0 12 28 0 #55000000">
        <suki:GlassCard IsOpaque="True"
                        CornerRadius="12"
                        Padding="10,8">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Text="✨ DSL 標籤區塊自動完成"
                         FontSize="11.5"
                         FontWeight="SemiBold"
                         Opacity="0.78" />
              <TextBlock Grid.Column="1"
                         Text="↑↓ 選擇 · Tab / Enter 套用 · Esc 關閉"
                         FontSize="11"
                         Opacity="0.58" />
            </Grid>

            <Border Height="1" Background="{DynamicResource SukiBorderBrush}" Opacity="0.45" />

            <ScrollViewer MaxHeight="290"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DslSuggestionItemVm">
                    <Button Classes="Basic"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0"
                            Margin="0,1"
                            Command="{Binding SelectCommand}"
                            Cursor="Hand">
                      <Border Classes="dsl-suggestion-row"
                              Classes.selected="{Binding IsSelected}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">

                          <!-- 類別徽章 -->
                          <Border Grid.Column="0"
                                  CornerRadius="6"
                                  Background="{DynamicResource SukiPrimaryColor15}"
                                  Padding="6,2"
                                  VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Icon}" FontSize="11" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding CategoryBadge}"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource SukiPrimaryColor}"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                          </Border>

                          <!-- 主顯示名稱（作者名 / 標籤中文＋原文 / 欄位名） -->
                          <TextBlock Grid.Column="1"
                                     Text="{Binding DisplayText}"
                                     FontSize="12.5"
                                     FontWeight="Medium"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />

                          <!-- 作品數量或說明 -->
                          <TextBlock Grid.Column="2"
                                     Text="{Binding SubText}"
                                     FontSize="11"
                                     Opacity="0.65"
                                     VerticalAlignment="Center" />

                          <!-- 動作提示 -->
                          <Border Grid.Column="3"
                                  CornerRadius="5"
                                  Background="#18808080"
                                  Padding="5,1"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActionHintText}"
                                       FontSize="10.5"
                                       Opacity="0.72" />
                          </Border>

                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </suki:GlassCard>
      </Border>
    </Popup>

  </StackPanel>
</UserControl>
