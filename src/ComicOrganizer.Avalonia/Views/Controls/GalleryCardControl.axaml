<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:Class="ComicOrganizer.Avalonia.Views.Controls.GalleryCardControl">

  <suki:GlassCard x:Name="RootCard"
                  Classes="gallery-item-card"
                  IsAnimated="False"
                  Width="{DynamicResource GalleryCardWidth}"
                  CornerRadius="13"
                  Padding="10"
                  Margin="0,0,12,12">
    <suki:GlassCard.ContextMenu>
      <ContextMenu>
        <MenuItem Header="📖 以內建閱讀器開啟" Click="OnOpenInReaderClick" />
        <MenuItem Header="↗ 以外部預設程式開啟" Click="OnOpenExternalClick" />
        <MenuItem Header="ℹ 查看 / 編輯詳細資訊" Click="OnInspectDetailClick" />
        <MenuItem Header="📂 在檔案總管中顯示" Click="OnRevealInExplorerClick" />
      </ContextMenu>
    </suki:GlassCard.ContextMenu>

    <StackPanel Spacing="7">

      <!-- 點擊封面或標題：資料夾為進入子目錄，作品為內建閱讀器開啟 -->
      <Button x:Name="ActivateButton"
              Classes="Basic gallery-card-activate"
              Padding="0"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Click="OnActivateClick">
        <StackPanel Spacing="7">
          <Border Width="{DynamicResource GalleryCardCoverWidth}"
                  HorizontalAlignment="Left"
                  Height="{DynamicResource GalleryCardCoverHeight}"
                  CornerRadius="9"
                  ClipToBounds="True"
                  Background="#18808080">
            <Grid>
              <Border x:Name="AccentBorder"
                      Opacity="0.22" />
              <TextBlock x:Name="FallbackGlyphText"
                         FontSize="36"
                         FontWeight="Bold"
                         Opacity="0.68"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <Image x:Name="CoverImage"
                     Classes="gallery-cover-fade"
                     IsVisible="False"
                     Stretch="UniformToFill" />

              <!-- 左上：狀態 / 資料夾角標 -->
              <Border HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="6"
                      Background="#B8000000"
                      CornerRadius="6"
                      Padding="6,2">
                <TextBlock x:Name="TypeBadgeText"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           Foreground="White" />
              </Border>

              <!-- 右上：頁數角標 -->
              <Border x:Name="PageCountBorder"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="6"
                      IsVisible="False"
                      Background="#B8000000"
                      CornerRadius="6"
                      Padding="6,2">
                <TextBlock x:Name="PageCountText"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           Foreground="White" />
              </Border>
            </Grid>
          </Border>

          <!-- 明確給定與封面相同的固定寬度，避免 TextWrapping/TextTrimming 在 Measure 與 Arrange 階段重算兩次 TextLayout -->
          <StackPanel Spacing="2"
                      Width="{DynamicResource GalleryCardCoverWidth}"
                      HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText"
                       FontSize="13"
                       FontWeight="SemiBold"
                       MaxLines="2"
                       MinHeight="34"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SubtitleText"
                       FontSize="11"
                       Opacity="0.65"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
      </Button>

      <!-- 底部動作列 -->
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
        <TextBlock x:Name="ModifiedText"
                   Grid.Column="0"
                   FontSize="10.5"
                   Opacity="0.55"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="Outlined"
                Padding="7,3"
                Click="OnInspectDetailClick"
                ToolTip.Tip="在右側抽屜查看或編輯詳細資訊">
          <TextBlock Text="ℹ" FontSize="11.5" FontWeight="SemiBold" />
        </Button>
        <Button Grid.Column="2"
                Classes="Outlined"
                Padding="7,3"
                Click="OnRevealInExplorerClick"
                ToolTip.Tip="在檔案總管中顯示">
          <TextBlock Text="📂" FontSize="11.5" />
        </Button>
      </Grid>

    </StackPanel>
  </suki:GlassCard>
</UserControl>
