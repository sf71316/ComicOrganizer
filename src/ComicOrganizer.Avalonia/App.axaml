<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ComicOrganizer.Avalonia"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:Class="ComicOrganizer.Avalonia.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <FontFamily x:Key="AppFontFamily">Microsoft JhengHei UI, Noto Sans TC, Inter, Segoe UI</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <suki:SukiTheme ThemeColor="Blue" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>
    <Style Selector="suki|SukiWindow">
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>
    <!-- 停用 SukiUI 7.0.1 GlassCard 預設的由上往下裁切進場動畫（OnAttachedToVisualTree），避免虛擬化卡片與切目錄時整頁拉窗簾重繪 -->
    <Style Selector="suki|GlassCard">
      <Setter Property="IsAnimated" Value="False" />
    </Style>
  </Application.Styles>

</Application>
